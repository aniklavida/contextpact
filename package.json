{
  "name": "@aniklavida/contextpact",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first context and coordination for people working across AI tools.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Md Habibur Rahman",
    "url": "https://github.com/aniklavida"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aniklavida/contextpact.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "contextpact": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run test && npm run build",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "smol-toml": "^1.8.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "prettier": "^3.6.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
